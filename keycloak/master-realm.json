{
  "realm": "master",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "keycloak@localhost",
    "fromDisplayName": "Keycloak",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "clients": [
    {
      "clientId": "security-admin-console",
      "enabled": true,
      "publicClient": true,
      "rootUrl": "${authAdminUrl}",
      "baseUrl": "/admin/master/console/",
      "redirectUris": [
        "/admin/master/console/*",
        "http://localhost:3000/*",
        "http://localhost:8080/realms/master/group-mgmt/*"
      ],
      "webOrigins": [
        "+",
        "http://localhost:3000"
      ],
      "protocol": "openid-connect",
      "standardFlowEnabled": true
    }
  ]
}
