<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="1" author="weare5stones">
        <createTable tableName="group_invitation">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="realm_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="group_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="inviter_user_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="token" type="VARCHAR(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="roles" type="VARCHAR(255)" defaultValue="">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="group_invitation" indexName="idx_gi_realm_group">
            <column name="realm_id"/>
            <column name="group_id"/>
        </createIndex>

        <createIndex tableName="group_invitation" indexName="idx_gi_token" unique="true">
            <column name="token"/>
        </createIndex>

        <addUniqueConstraint
            tableName="group_invitation"
            columnNames="realm_id, group_id, email"
            constraintName="uk_gi_realm_group_email"/>

        <createTable tableName="group_member_role">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="realm_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="group_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
            tableName="group_member_role"
            columnNames="realm_id, group_id, user_id, role"
            constraintName="uk_gmr_realm_group_user_role"/>

        <createIndex tableName="group_member_role" indexName="idx_gmr_realm_user_group">
            <column name="realm_id"/>
            <column name="user_id"/>
            <column name="group_id"/>
        </createIndex>

        <createIndex tableName="group_member_role" indexName="idx_gmr_realm_group_role">
            <column name="realm_id"/>
            <column name="group_id"/>
            <column name="role"/>
        </createIndex>

        <rollback>
            <dropTable tableName="group_member_role"/>
            <dropTable tableName="group_invitation"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
